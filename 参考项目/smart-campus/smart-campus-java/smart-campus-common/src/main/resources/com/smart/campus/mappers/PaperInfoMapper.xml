<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.campus.mappers.PaperInfoMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.smart.campus.entity.po.PaperInfo">
		<!--主键ID-->
		<result column="paper_id" property="paperId"  />
		<!--试卷名称-->
		<result column="paper_name" property="paperName"  />
		<!--试卷类型:1课后习题 2考试试卷-->
		<result column="paper_type" property="paperType"  />
		<!--试卷说明-->
		<result column="description" property="description"  />
		<!--试卷总分-->
		<result column="total_score" property="totalScore"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 p.paper_id,p.paper_name,p.paper_type,p.description,p.total_score,
		 p.create_time,p.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.paperId != null and query.paperId!=''">
				 and  p.paper_id = #{query.paperId}
			</if>
			<if test="query.paperName != null and query.paperName!=''">
				 and  p.paper_name = #{query.paperName}
			</if>
			<if test="query.paperType != null">
				 and  p.paper_type = #{query.paperType}
			</if>
			<if test="query.description != null and query.description!=''">
				 and  p.description = #{query.description}
			</if>
			<if test="query.totalScore != null">
				 and  p.total_score = #{query.totalScore}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  p.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  p.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.paperIdFuzzy!= null  and query.paperIdFuzzy!=''">
				 and  p.paper_id like concat('%', #{query.paperIdFuzzy}, '%')
			</if>
			<if test="query.paperNameFuzzy!= null  and query.paperNameFuzzy!=''">
				 and  p.paper_name like concat('%', #{query.paperNameFuzzy}, '%')
			</if>
			<if test="query.descriptionFuzzy!= null  and query.descriptionFuzzy!=''">
				 and  p.description like concat('%', #{query.descriptionFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  p.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  p.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  p.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  p.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM paper_info p <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM paper_info p <include refid="query_condition" />
	</select>

	<!-- 插入 （匹配有值的字段）-->
	<insert id="insert" parameterType="com.smart.campus.entity.po.PaperInfo">
		 INSERT INTO paper_info
		 <trim prefix="(" suffix=")" suffixOverrides="," >
