			</if>
			<if test="bean.createTime != null">
				 create_time,
			</if>
			<if test="bean.updateTime != null">
				 update_time,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.paperId!=null">
				 #{bean.paperId},
			</if>
			<if test="bean.paperName!=null">
				 #{bean.paperName},
			</if>
			<if test="bean.paperType!=null">
