			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.messageTitleFuzzy!= null  and query.messageTitleFuzzy!=''">
				 and  m.message_title like concat('%', #{query.messageTitleFuzzy}, '%')
			</if>
			<if test="query.messageContentFuzzy!= null  and query.messageContentFuzzy!=''">
