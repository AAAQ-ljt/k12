            <if test="bean.createTime != null">#{bean.createTime},</if>
            <if test="bean.lastUpdateTime != null">#{bean.lastUpdateTime},</if>
        </trim>
    </insert>

    <insert id="insertOrUpdate" parameterType="com.smart.campus.entity.po.SystemMenu">
        INSERT INTO system_menu(menu_code,menu_name,parent_code,menu_path,route_name,menu_type,sort_order,status,remark,create_time,last_update_time)
        VALUES(#{bean.menuCode},#{bean.menuName},#{bean.parentCode},#{bean.menuPath},#{bean.routeName},#{bean.menuType},#{bean.sortOrder},#{bean.status},#{bean.remark},#{bean.createTime},#{bean.lastUpdateTime})
        ON DUPLICATE KEY UPDATE
        menu_name = VALUES(menu_name),parent_code = VALUES(parent_code),menu_path = VALUES(menu_path),route_name = VALUES(route_name),
        menu_type = VALUES(menu_type),sort_order = VALUES(sort_order),status = VALUES(status),remark = VALUES(remark),last_update_time = VALUES(last_update_time)
    </insert>

    <insert id="insertBatch">
        INSERT INTO system_menu(menu_code,menu_name,parent_code,menu_path,route_name,menu_type,sort_order,status,remark,create_time,last_update_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.menuCode},#{item.menuName},#{item.parentCode},#{item.menuPath},#{item.routeName},#{item.menuType},#{item.sortOrder},#{item.status},#{item.remark},#{item.createTime},#{item.lastUpdateTime})
        </foreach>
