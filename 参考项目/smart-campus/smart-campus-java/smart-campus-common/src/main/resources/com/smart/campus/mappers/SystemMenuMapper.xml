    </insert>

    <update id="updateByParam">
        UPDATE system_menu s
        <set>
            <if test="bean.menuCode != null">menu_code = #{bean.menuCode},</if>
            <if test="bean.menuName != null">menu_name = #{bean.menuName},</if>
            <if test="bean.parentCode != null">parent_code = #{bean.parentCode},</if>
            <if test="bean.menuPath != null">menu_path = #{bean.menuPath},</if>
            <if test="bean.routeName != null">route_name = #{bean.routeName},</if>
            <if test="bean.menuType != null">menu_type = #{bean.menuType},</if>
            <if test="bean.sortOrder != null">sort_order = #{bean.sortOrder},</if>
