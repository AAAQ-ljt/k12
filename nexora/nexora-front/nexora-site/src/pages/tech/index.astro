---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaSection from '../../components/CtaSection.astro';

const title = '技术架构 · AI 如何做到"能教课" — Nexora';
const description =
    'Nexora 的技术底座：RAG 双库检索、MCP 白名单工具调用、Netty WebSocket 流式输出、'
    + '掌握度模型与 AI 用量统计——通俗讲清 AI 助教为什么可信、可控、可审计。';

const pillars = [
  {
    icon: 'search',
    title: 'RAG 双库检索',
    plain: 'AI 回答之前，先去图书馆查资料。',
    detail:
        '课程知识库（官方维护、按学段过滤）与学生个人知识库（用户确认入库的 Wiki 页）同时检索，'
        + '命中片段作为上下文喂给模型——回答有出处，而不是凭空发挥。向量库基于 Elasticsearch，'
        + '关键词检索作为向量失败的回退兜底。',
  },
  {
    icon: 'wrench',
    title: 'MCP 白名单工具',
    plain: 'AI 不只会说，还能"做"，但只做允许的事。',
    detail:
        '教学动作（查学习进度、出题、维护知识页等）被封装成 MCP 协议下的白名单工具，'
        + '模型只能调用登记过的能力，不能执行任意指令——这是教学场景安全性的底线。',
  },
  {
    icon: 'zap',
    title: 'WebSocket 流式输出',
    plain: '回复像打字一样逐字到达，不用等全部生成完。',
    detail:
        '对话通过 Netty WebSocket 通道推送：模型每生成一段就立刻下发一段，'
        + '前端边收边渲染，长回答的等待感被压缩到首字延迟。',
  },
  {
    icon: 'trend',
    title: '掌握度模型',
    plain: '做错的题不会被遗忘，它变成了复习计划。',
    detail:
        '每次判分（练习、测验、路径自测）都会回写对应知识点的掌握度；'
        + '掌握度驱动学习路径节点解锁、智能跳题与遗忘曲线复习排期。',
  },
  {
    icon: 'receipt',
    title: 'AI 用量统计',
    plain: '每一次模型调用都有账可查。',
    detail:
        '对话类调用由统一 Advisor 上报 Token 消耗，生图按张计次；'
        + '按日聚合落库，管理端可审计——成本可控，也便于向学校交代。',
  },
  {
    icon: 'smile',
    title: '学段自适应引擎',
    plain: '同一道题，三个学段听到三种讲法。',
    detail:
        '学段冗余在用户档案上：提示词模板、知识检索过滤、难度梯度、交互形态入口全部按学段切换，'
        + '由统一的学段配置驱动而非散落的 if-else。',
  },
];
---

<Base title={title} description={description} path="/tech/">
  <section class="thero">
    <div class="container">
      <div class="section-head reveal" style="margin-bottom:0">
        <p class="eyebrow">Under the hood</p>
        <h1 class="section-title" style="font-size:var(--fs-h1)">
          AI 如何做到<span class="grad">"能教课"</span>
        </h1>
        <p class="section-lede">
          一句话版本：先查资料再回答（RAG）、只做被允许的教学动作（MCP）、边想边说（流式）、
          把每次练习变成数据（掌握度），并且每笔账都可查（用量统计）。
        </p>
      </div>
    </div>
  </section>
  <!-- 一条消息的旅程 -->
  <section class="section" style="padding-top:2.8rem">
    <div class="container container--narrow">
      <div class="section-head reveal">
        <p class="eyebrow">Trace</p>
        <h2 class="section-title">一条消息的<span class="grad">旅程</span></h2>
        <p class="section-lede">从孩子按下回车，到答案逐字出现，中间发生了这七件事。</p>
      </div>
      <ol class="journey">
        {[
          { t: '消息发出', d: 'HTTP 入口接收消息并落库，回复通道走 WebSocket（Netty）。' },
          { t: '意图路由', d: '先判断这句话想做什么：讲解、出资料、出题、画图还是做绘本。' },
          { t: '双库检索', d: 'RAG 同时查课程知识库与个人知识库，按学段过滤，命中片段作为依据。' },
          { t: '上下文组装', d: '学段提示词 + 历史对话 + 检索片段 + 白名单工具，拼成这次的"教案"。' },
          { t: '流式生成', d: '模型边生成边推送，前端逐字渲染，首字即达。' },
          { t: '产物卡片', d: '需要动画/绘本/绘画/题目时，异步任务生成后以卡片回到对话。' },
          { t: '落库与记账', d: '消息与 Token 用量入库；若这一轮做了题，掌握度同步回写。' },
        ].map((step, i) => (
          <li class="journey__item reveal" style={`--reveal-delay:${i * 0.06}s`}>
            <span class="journey__dot" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="journey__body">
              <h3 class="journey__title">{step.t}</h3>
              <p class="journey__desc">{step.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 架构图：分层关系 -->
  <section class="section" style="padding-top:2.6rem">
    <div class="container">
      <div class="arch reveal">
        <div class="arch__tier">
          <span class="arch__label">触达层</span>
          <div class="arch__boxes">
            <div class="arch__box">学生端 <small>React · WebSocket</small></div>
            <div class="arch__box">管理端 <small>React · 运营配置</small></div>
          </div>
        </div>
        <div class="arch__flow" aria-hidden="true">↓</div>
        <div class="arch__tier">
          <span class="arch__label">服务层</span>
          <div class="arch__boxes">
            <div class="arch__box">学生端服务 <small>对话 · 路径 · 分析</small></div>
            <div class="arch__box">管理端服务 <small>课程 · 题库 · 审核</small></div>
            <div class="arch__box">MCP 工具服务 <small>白名单教学工具</small></div>
          </div>
        </div>
        <div class="arch__flow" aria-hidden="true">↓</div>
        <div class="arch__tier">
          <span class="arch__label">AI 与数据层</span>
          <div class="arch__boxes">
            <div class="arch__box arch__box--brand">RAG 检索 <small>Elasticsearch</small></div>
            <div class="arch__box arch__box--brand">大模型网关 <small>Spring AI</small></div>
            <div class="arch__box arch__box--brand">任务状态机 <small>Redis</small></div>
            <div class="arch__box arch__box--brand">业务数据 <small>MySQL</small></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 六大支柱 -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="pillars">
        {pillars.map((p, i) => (
          <article class="pillar glass-card reveal" style={`--reveal-delay:${(i % 2) * 0.08}s`} data-spotlight>
            <span class="pillar__icon" aria-hidden="true"><Icon name={p.icon} size={26} /></span>
            <h2 class="pillar__title">{p.title}</h2>
            <p class="pillar__plain">{p.plain}</p>
            <p class="pillar__detail">{p.detail}</p>
          </article>
        ))}
      </div>
      <p class="tech-foot reveal">
        工程栈：SpringBoot 3 · Spring AI · MySQL · Redis · Elasticsearch · Netty · React 19 · Vite
      </p>
    </div>
  </section>

  <CtaSection />
</Base>

<style>
  .thero { padding-block: clamp(3.6rem, 7vw, 5.5rem) 0; }
  .container--narrow { max-width: 820px; }

  /* ---------- 一条消息的旅程 ---------- */
  .journey { position: relative; display: grid; gap: 1.4rem; }
  .journey::before {
    content: "";
    position: absolute;
    left: 1.15rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 1px;
    background: linear-gradient(180deg, var(--aurora-1), var(--aurora-2) 55%, var(--aurora-3));
    opacity: 0.5;
  }
  .journey__item {
    position: relative;
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }
  .journey__dot {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 2.35rem;
    height: 2.35rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 1px solid var(--stroke-brand);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--brand-400);
    box-shadow: 0 0 0 5px var(--bg-base);
  }
  .journey__body {
    padding: 0.9rem 1.2rem;
    border-radius: var(--r-md);
    background: var(--bg-card);
    border: 1px solid var(--stroke-subtle);
    flex: 1;
  }
  .journey__title { font-size: var(--fs-body); }
  .journey__desc { margin-top: 0.3rem; font-size: var(--fs-sm); color: var(--text-secondary); }

  /* ---------- 架构图 ---------- */
  .arch {
    max-width: 900px;
    margin-inline: auto;
    display: grid;
    gap: 0.4rem;
  }
  .arch__tier {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.1rem 1.2rem;
    border-radius: var(--r-lg);
    background: var(--bg-deep);
    border: 1px solid var(--stroke-subtle);
  }
  .arch__label {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }
  .arch__boxes { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .arch__box {
    padding: 0.6rem 1rem;
    border-radius: var(--r-md);
    background: var(--bg-card);
    border: 1px solid var(--stroke-subtle);
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .arch__box small { display: block; color: var(--text-muted); font-size: var(--fs-xs); }
  .arch__box--brand {
    border-color: var(--stroke-brand);
    background: rgba(134, 59, 255, 0.1);
  }
  .arch__flow { text-align: center; color: var(--text-muted); font-size: 0.9rem; }

  /* ---------- 支柱 ---------- */
  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .pillar { padding: 1.7rem 1.6rem; }
  .pillar__icon { display: block; margin-bottom: 0.2rem; color: var(--icon-color); }
  .pillar__title { font-size: var(--fs-h3); margin-top: 0.8rem; }
  .pillar__plain {
    margin-top: 0.4rem;
    color: var(--text-primary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }
  .pillar__detail {
    margin-top: 0.55rem;
    color: var(--text-secondary);
    font-size: var(--fs-sm);
  }
  .tech-foot {
    margin-top: 2rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .pillars { grid-template-columns: 1fr; }
    .arch__tier { grid-template-columns: 1fr; gap: 0.7rem; }
    .arch__boxes { display: grid; grid-template-columns: 1fr 1fr; }
  }
</style>
