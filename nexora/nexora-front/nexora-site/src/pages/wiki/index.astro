---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import WikiFlow from '../../components/WikiFlow.astro';
import CtaSection from '../../components/CtaSection.astro';

const title = 'AI 个人知识库 · 会自己长大的 Wiki — Nexora';
const description =
    '把资料上传给 Nexora，AI 自动整理成结构化的个人 Wiki 知识页：草稿可编辑、确认后才入库向量化，'
    + '还能在对话里让 AI 直接维护页面。知识库越充实，AI 越懂你。';

const traits = [
  {
    icon: 'pencil',
    title: '草稿可编辑，AI 不是黑盒',
    desc: 'AI 整理出的每一页都是草稿：标题、正文、双链引用都可以改，改完再入库。',
  },
  {
    icon: 'shield',
    title: '确认后才入库，检索可信',
    desc: '只有你确认过的页面才会向量化。检索与 AI 作答只认入库内容，来源可查、范围可控。',
  },
  {
    icon: 'message',
    title: '对话即维护',
    desc: '在 AI 助教对话里说一声"把今天学的记到知识页"，AI 会新建、更新页面并直接入库——背后是白名单化的 MCP 工具调用。',
  },
  {
    icon: 'layers',
    title: '三类目录 + 双链引用',
    desc: 'raw 放原始资料，wiki 放知识页，attachments 放附件；页面间 Obsidian 风格 [[双链]] 相互引用，知识长成网络。',
  },
];

const qa = [
  {
    q: '它和课程知识库有什么区别？',
    a: '课程知识库是官方维护的通用内容，面向所有学生；个人知识库由你上传的资料构成，只属于你。AI 回答时会同时检索两库——通用知识打底，你的知识页让回答更贴合你的学习轨迹。',
  },
  {
    q: 'AI 整理错了怎么办？',
    a: '整理结果只是草稿。你可以逐页编辑修正，不满意的可以丢弃重来；只有点过确认的页面才会进入检索范围。',
  },
  {
    q: '支持哪些格式？',
    a: 'Markdown、纯文本、图片，以及 Word、PDF 等常见文档白名单格式；单文件与总额度在产品内有明确上限提示。',
  },
];
---

<Base title={title} description={description} path="/wiki/">
  <!-- ============ Hero ============ -->
  <section class="whero">
    <div class="container">
      <div class="whero__inner reveal">
        <p class="chip chip--brand whero__badge">★ 全产品最具特色</p>
        <h1 class="whero__title">
          你的知识库，<span class="grad">会自己长大</span>
        </h1>
        <p class="whero__lede">
          上传资料，AI 来维护。每一份被整理、被确认、被引用的知识，都在悄悄改写 AI 对你的理解——
          这不是一本静态的笔记，而是一个随你学习的知识库。
        </p>
      </div>
    </div>
  </section>

  <!-- ============ 四步流程 ============ -->
  <section class="section" style="padding-top:1rem">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">How it works</p>
        <h2 class="section-title">四步，让资料变成<span class="grad">懂你的知识</span></h2>
      </div>
      <WikiFlow />
    </div>
  </section>

  <!-- ============ 特性 ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Principles</p>
        <h2 class="section-title">可控，才敢<span class="grad">交给 AI</span></h2>
      </div>
      <div class="traits">
        {traits.map((t, i) => (
          <div class="traits__item glass-card reveal" style={`--reveal-delay:${(i % 2) * 0.1}s`} data-spotlight>
            <span class="traits__icon" aria-hidden="true"><Icon name={t.icon} size={26} /></span>
            <h3 class="traits__title">{t.title}</h3>
            <p class="traits__desc">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 双库协同 ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Dual Retrieval</p>
        <h2 class="section-title">官方打底，<span class="grad">个人贴合</span></h2>
        <p class="section-lede">AI 回答一次问题，其实同时检索了两个知识库。</p>
      </div>
      <div class="dual reveal">
        <div class="dual__box glass-card">
          <span class="chip">课程知识库</span>
          <h3>官方 · 通用打底</h3>
          <p>按学段筛选的课程知识，保证科学性与课标对齐，是回答的"教材部分"。</p>
        </div>
        <div class="dual__plus" aria-hidden="true">＋</div>
        <div class="dual__box dual__box--brand glass-card">
          <span class="chip chip--brand">个人知识库</span>
          <h3>你的 · 贴合作答</h3>
          <p>你自己整理的 Wiki 页带着你的理解与笔记，让回答接得上你已有的认知。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 目录结构与配额 ============ -->
  <section class="section">
    <div class="container wstruct">
      <div class="wstruct__tree glass-card reveal" role="img" aria-label="个人知识库目录结构示意">
        <div class="wstruct__tree-bar">
          <span class="wstruct__dot"></span><span class="wstruct__dot"></span><span class="wstruct__dot"></span>
          <span class="wstruct__path">我的资源中心</span>
        </div>
        <pre class="wstruct__code"><code>{`我的资源中心
├─ raw/            原始资料区
│   ├─ 课堂笔记.md
│   └─ 老师发的讲义.pdf
├─ wiki/           知识页区 ★
│   ├─ 机器学习入门笔记.md
│   │   └─ 引用 [[梯度下降]] [[监督学习]]
│   └─ 监督学习 · 课堂要点.md
└─ attachments/    附件区
    └─ 讲义插图.png`}</code></pre>
      </div>

      <div class="wstruct__side">
        <h2 class="section-title reveal">一切<span class="grad">井井有条</span></h2>
        <p class="wstruct__lede reveal">
          三类目录各司其职：raw 存原始资料，wiki 放 AI 整理与你自己维护的知识页，
          attachments 收纳图片附件。知识页之间用 Obsidian 风格的
          <span class="wstruct__wikilink">[[双链]]</span> 相互引用，知识越连越密。
        </p>
        <div class="wstruct__meta reveal">
          <h3 class="wstruct__sub">支持的格式</h3>
          <div class="wstruct__chips">
            <span class="chip">Markdown</span>
            <span class="chip">纯文本</span>
            <span class="chip">图片</span>
            <span class="chip">Word</span>
            <span class="chip">PDF</span>
          </div>
          <h3 class="wstruct__sub">容量</h3>
          <div class="wstruct__quota reveal">
            <div class="wstruct__quota-bar">
              <span style="width:34%"></span>
            </div>
            <p class="wstruct__quota-note">单文件 ≤ 20MB · 个人总额度 300MB，产品内实时显示剩余空间</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 问答 ============ -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section-head reveal">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">关于知识库的<span class="grad">三个问题</span></h2>
      </div>
      <div class="wfaq">
        {qa.map((item) => (
          <details class="wfaq__item glass-card reveal">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p class="whero__cta reveal">
        <a class="btn btn--primary btn--lg" href={SITE.studentUrl} target="_blank" rel="noopener">
          上传第一份资料试试 ↗
        </a>
      </p>
    </div>
  </section>

  <CtaSection />
</Base>

<style>
  .container--narrow { max-width: 820px; }

  /* ---------- Hero ---------- */
  .whero { padding-block: clamp(4rem, 8vw, 6.5rem) 0; }
  .whero__inner { text-align: center; max-width: 780px; margin-inline: auto; }
  .whero__badge { margin-bottom: 1.4rem; }
  .whero__title { font-size: var(--fs-display); }
  .whero__title .grad {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .whero__lede { margin-top: 1.3rem; color: var(--text-secondary); font-size: 1.06rem; }
  .whero__cta { text-align: center; margin-top: 2.4rem; }

  /* ---------- 特性 ---------- */
  .traits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .traits__item { padding: 1.7rem 1.6rem; }
  .traits__icon { display: block; margin-bottom: 0.9rem; color: var(--icon-color); }
  .traits__title { font-size: var(--fs-h3); margin-bottom: 0.55rem; }
  .traits__desc { font-size: var(--fs-sm); color: var(--text-secondary); }

  /* ---------- 双库 ---------- */
  .dual {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.4rem;
    align-items: stretch;
  }
  .dual__box { padding: 1.8rem 1.6rem; }
  .dual__box h3 { font-size: var(--fs-h3); margin: 0.9rem 0 0.55rem; }
  .dual__box p { font-size: var(--fs-sm); color: var(--text-secondary); }
  .dual__box--brand { border-color: var(--stroke-brand); background:
      linear-gradient(150deg, rgba(134, 59, 255, 0.12), transparent 60%), var(--bg-card); }
  .dual__plus {
    align-self: center;
    font-size: 2rem;
    color: var(--text-muted);
    font-weight: 300;
  }

  /* ---------- FAQ ---------- */
  .wfaq { display: grid; gap: 0.9rem; }
  .wfaq__item { padding: 0; overflow: hidden; }
  .wfaq__item summary {
    list-style: none;
    cursor: pointer;
    padding: 1.15rem 1.4rem;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-body);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .wfaq__item summary::-webkit-details-marker { display: none; }
  .wfaq__item summary::after {
    content: "+";
    font-size: 1.3rem;
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease-out);
    line-height: 1;
  }
  .wfaq__item[open] summary::after { transform: rotate(45deg); }
  .wfaq__item p {
    padding: 0 1.4rem 1.25rem;
    color: var(--text-secondary);
    font-size: var(--fs-sm);
  }

  @media (max-width: 820px) {
    .traits { grid-template-columns: 1fr; }
    .dual { grid-template-columns: 1fr; }
    .dual__plus { text-align: center; }
  }

  /* ---------- 目录结构与配额 ---------- */
  .wstruct {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.6rem, 4vw, 3.2rem);
    align-items: center;
  }
  .wstruct__tree {
    padding: 0;
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .wstruct__tree-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--divider);
  }
  .wstruct__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }
  .wstruct__path { margin-left: 0.4rem; font-size: var(--fs-xs); color: var(--text-muted); }
  .wstruct__code {
    padding: 1.2rem 1.3rem 1.4rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.9;
    color: var(--text-secondary);
    overflow-x: auto;
  }
  .wstruct__lede { margin-top: 0.9rem; color: var(--text-secondary); font-size: var(--fs-sm); }
  .wstruct__wikilink {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--accent-cyan);
    border-bottom: 1px dashed rgba(79, 172, 254, 0.5);
  }
  .wstruct__meta { margin-top: 1.6rem; }
  .wstruct__sub {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin: 1.3rem 0 0.55rem;
  }
  .wstruct__chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .wstruct__quota-bar {
    height: 8px;
    border-radius: var(--r-full);
    background: var(--bg-card);
    border: 1px solid var(--stroke-subtle);
    overflow: hidden;
  }
  .wstruct__quota-bar span {
    display: block;
    height: 100%;
    border-radius: var(--r-full);
    background: var(--gradient-aurora);
  }
  .wstruct__quota-note { margin-top: 0.5rem; font-size: var(--fs-xs); color: var(--text-muted); }

  @media (max-width: 900px) {
    .wstruct { grid-template-columns: 1fr; }
  }
</style>
