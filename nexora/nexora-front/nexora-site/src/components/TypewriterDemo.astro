---
/**
 * 首屏「会打字」的 AI 助教演示：
 * 学生提问 → 输入中 → AI 流式回复 → 弹出产物卡片 → 停留 → 清空循环。
 * 演示数据内联于下方 JSON（type="application/json"），改文案无需动脚本。
 */
interface DemoRound {
  question: string;
  answer: string;
  /** 流式回复结束后弹出的产物卡片（可空） */
  card?: { title: string; meta: string };
}
const rounds: DemoRound[] = [
  {
    question: '什么是机器学习？举个我身边的例子',
    answer:
        '机器学习就是让计算机从数据里自己找规律。比如音乐 App 听你循环播放的歌单，慢慢就能猜到你下一首想听什么——它没有背规则，是从你的行为里学出来的。',
    card: { title: '分步动画 · 机器学习是怎么"学"的', meta: '6 步 · 约 40 秒' },
  },
  {
    question: '帮我出两道关于它的练习题',
    answer:
        '好，从你的学习路径里挑了两道：第 1 题概念辨析，第 2 题生活场景应用。答错也没关系，我会把知识点记进你的掌握度，复习时再见到它。',
    card: { title: '答题卡 · 机器学习 2 题', meta: '即时批改 · 计入掌握度' },
  },
];
---

<div class="tw" role="img" aria-label="AI 助教对话演示动画">
  <div class="tw__window glass-card">
    <div class="tw__bar">
      <span class="tw__dot"></span><span class="tw__dot"></span><span class="tw__dot"></span>
      <span class="tw__title">Nexora AI 助教</span>
      <span class="chip chip--dot tw__online">在线</span>
    </div>

    <div class="tw__body">
      <div class="tw__msg tw__msg--user">
        <span data-tw-question>{rounds[0]!.question}</span>
      </div>

      <div class="tw__msg tw__msg--ai" data-tw-ai hidden>
        <span class="tw__avatar" aria-hidden="true">AI</span>
        <div class="tw__bubble">
          <span class="tw__typing" data-tw-typing><i></i><i></i><i></i></span>
          <span data-tw-answer></span>
          <span class="tw__caret" data-tw-caret hidden></span>
        </div>
      </div>

      <div class="tw__card" data-tw-card hidden>
        <div>
          <p class="tw__card-title" data-tw-card-title>{rounds[0]!.card?.title}</p>
          <p class="tw__card-meta" data-tw-card-meta>{rounds[0]!.card?.meta}</p>
        </div>
        <span class="tw__card-arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </div>
  <p class="tw__hint">真实产品中，回复与卡片会流式逐字到达</p>
</div>

<script type="application/json" data-tw-data set:html={JSON.stringify(rounds)} />

<script>
  const root = document.querySelector<HTMLElement>('[data-tw-data]')?.parentElement
      ?? document.querySelector('.tw');
  const dataEl = document.querySelector<HTMLScriptElement>('script[data-tw-data]');

  if (root && dataEl) {
    const rounds: { question: string; answer: string; card?: { icon: string; title: string; meta: string } }[] =
        JSON.parse(dataEl.textContent ?? '[]');
    const qEl = root.querySelector<HTMLElement>('[data-tw-question]');
    const aiEl = root.querySelector<HTMLElement>('[data-tw-ai]');
    const typingEl = root.querySelector<HTMLElement>('[data-tw-typing]');
    const aEl = root.querySelector<HTMLElement>('[data-tw-answer]');
    const caretEl = root.querySelector<HTMLElement>('[data-tw-caret]');
    const cardEl = root.querySelector<HTMLElement>('[data-tw-card]');
    const cardTitleEl = root.querySelector<HTMLElement>('[data-tw-card-title]');
    const cardMetaEl = root.querySelector<HTMLElement>('[data-tw-card-meta]');

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function play() {
      for (;;) {
        for (const round of rounds) {
          // 1) 学生提问（瞬时，节奏靠停顿）
          if (qEl) qEl.textContent = round.question;
          aiEl?.setAttribute('hidden', '');
          cardEl?.setAttribute('hidden', '');
          await wait(900);

          // 2) 输入中 → 流式打字
          aiEl?.removeAttribute('hidden');
          if (typingEl) typingEl.style.display = 'inline-flex';
          if (aEl) aEl.textContent = '';
          caretEl?.setAttribute('hidden', '');
          await wait(700);
          if (typingEl) typingEl.style.display = 'none';
          if (caretEl) caretEl.removeAttribute('hidden');

          for (const ch of round.answer) {
            if (aEl) aEl.textContent += ch;
            await wait(24);
          }
          caretEl?.setAttribute('hidden', '');

          // 3) 产物卡片弹出
          if (round.card && cardEl && cardTitleEl && cardMetaEl) {
            cardTitleEl.textContent = round.card.title;
            cardMetaEl.textContent = round.card.meta;
            await wait(320);
            cardEl.classList.add('is-pop');
            cardEl.removeAttribute('hidden');
          }
          await wait(3600);
          cardEl?.classList.remove('is-pop');
        }
        await wait(600);
      }
    }
    play();
  }
</script>

<style>
  .tw { max-width: 560px; margin-inline: auto; width: 100%; }
  .tw__window {
    position: relative;
    padding: 0.9rem 1rem 1.2rem;
    box-shadow: var(--shadow-lg);
    text-align: left;
    background:
        linear-gradient(160deg, rgba(102, 126, 234, 0.08), transparent 42%),
        var(--bg-elevated);
    border-color: var(--stroke-subtle);
  }
  .tw__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--divider);
  }
  .tw__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }
  .tw__title { margin-left: 0.4rem; font-size: var(--fs-sm); color: var(--text-secondary); }
  .tw__online { margin-left: auto; }

  .tw__body { display: grid; gap: 0.8rem; padding-top: 1rem; min-height: 15.5em; align-content: start; }

  .tw__msg--user {
    justify-self: end;
    max-width: 88%;
    padding: 0.62rem 0.95rem;
    border-radius: var(--r-md) var(--r-md) var(--r-sm) var(--r-md);
    background: var(--gradient-btn);
    color: var(--text-on-brand);
    font-size: var(--fs-sm);
    line-height: 1.65;
    box-shadow: var(--shadow-brand);
  }

  .tw__msg--ai {
    display: flex;
    gap: 0.6rem;
    max-width: 94%;
    justify-self: start;
  }
  .tw__avatar {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: 700;
    color: #d9c8ff;
    background: var(--gradient-badge);
    box-shadow: var(--shadow-brand);
  }
  .tw__bubble {
    padding: 0.7rem 0.95rem;
    border-radius: var(--r-md) var(--r-md) var(--r-md) var(--r-sm);
    background: var(--bg-card);
    border: 1px solid var(--stroke-subtle);
    font-size: var(--fs-sm);
    line-height: 1.72;
    color: var(--text-secondary);
    min-height: 2.6em;
  }
  .tw__typing { display: inline-flex; gap: 4px; align-items: center; height: 1.2em; }
  .tw__typing i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-muted);
    animation: tw-bounce 1s infinite ease-in-out;
  }
  .tw__typing i:nth-child(2) { animation-delay: 0.15s; }
  .tw__typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes tw-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(-4px); opacity: 1; }
  }

  .tw__caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--aurora-3);
    animation: tw-caret 0.8s steps(1) infinite;
  }
  @keyframes tw-caret { 50% { opacity: 0; } }

  /* 产物卡片：从下方弹出 */
  .tw__card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.95rem;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.16), rgba(240, 147, 251, 0.12));
    border: 1px solid var(--stroke-brand);
    justify-self: start;
    margin-left: 2.4rem;
    max-width: 88%;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .tw__card.is-pop { opacity: 1; transform: translateY(0); }
  .tw__card-title { font-size: var(--fs-sm); color: var(--text-primary); font-weight: var(--fw-semibold); }
  .tw__card-meta { font-size: var(--fs-xs); color: var(--text-muted); margin-top: 0.15em; }
  .tw__card-arrow { margin-left: auto; color: var(--text-muted); }

  .tw__hint {
    text-align: center;
    margin-top: 0.9rem;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>

<script is:inline src="/js/neon-border.js" defer></script>
