---
import { SITE } from '../config/site';

/**
 * 3D 星球画廊 — 引擎取自 参考项目/k12bk/4.html（Sphere Gallery 3D, WebGL1/2）：
 * 卡面按 golden-angle 螺旋排上球体，可拖拽环游、滚轮缩放、悬停弹起。
 * 卡面为构建期生成的品牌渐变 SVG（data-URI，无外部图片）；WebGL 不可用时静默降级。
 */
const CARDS: [string, string, string][] = [
  ['AI 助教', '#667eea', '#9d6bff'],
  ['个人知识库', '#764ba2', '#f093fb'],
  ['学习路径', '#4facfe', '#7367f0'],
  ['课程教材', '#5b6ef5', '#9d6bff'],
  ['通关测验', '#f093fb', '#ff8ac9'],
  ['编程环境', '#667eea', '#4facfe'],
  ['SVG 动画', '#9d6bff', '#f093fb'],
  ['AI 绘本', '#764ba2', '#5b6ef5'],
  ['AI 绘画', '#f093fb', '#b39dff'],
  ['答题卡', '#4facfe', '#667eea'],
  ['学习分析', '#5b6ef5', '#764ba2'],
  ['遗忘复习', '#9d6bff', '#667eea'],
];

const images = CARDS.map(([label, a, b], i) => {
  const n = String(i + 1).padStart(2, '0');
  const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="800" height="560">` +
      `<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">` +
      `<stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/>` +
      `</linearGradient></defs>` +
      `<rect width="800" height="560" fill="url(#g)"/>` +
      `<circle cx="690" cy="90" r="150" fill="rgba(255,255,255,0.10)"/>` +
      `<circle cx="80" cy="500" r="90" fill="rgba(0,0,0,0.14)"/>` +
      `<polygon points="0,560 800,180 800,560" fill="rgba(255,255,255,0.05)"/>` +
      `<text x="52" y="82" font-family="system-ui,'PingFang SC','Microsoft YaHei',sans-serif" ` +
      `font-size="26" font-weight="600" letter-spacing="6" fill="rgba(255,255,255,0.62)">NEXORA · ${n}</text>` +
      `<text x="400" y="300" dy=".35em" text-anchor="middle" ` +
      `font-family="system-ui,'PingFang SC','Microsoft YaHei',sans-serif" ` +
      `font-size="76" font-weight="700" fill="rgba(255,255,255,0.95)">${label}</text>` +
      `</svg>`;
  return { image: 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg), link: SITE.studentUrl };
});
---

<div class="sphere" data-sphere aria-label="产品能力星球，可拖拽环游、滚轮缩放" role="img"></div>

<script is:inline define:vars={{ images }}>
  window.NEXORA_SPHERE_IMAGES = images;
</script>

<style>
  .sphere {
    position: relative;
    height: min(72vh, 620px);
    border-radius: var(--r-xl);
    border: 1px solid var(--stroke-subtle);
    overflow: hidden;
    background:
        radial-gradient(ellipse 90% 70% at 50% 115%, rgba(118, 75, 162, 0.28), transparent 60%),
        var(--bg-deep);
    cursor: grab;
  }
  .sphere:active { cursor: grabbing; }
</style>

<script is:inline src="/js/sphere-gallery.js" defer></script>
