---
import Icon from './Icon.astro';

/**
 * 技术信任条：数据条下方的极简技术亮点，点击进入 /tech/ 给评委看架构。
 * 有意不做成卡片——与上下两个玻璃面板拉开质感差异。
 */
const items = [
  { icon: 'search', label: 'RAG 双库检索', desc: '回答有出处' },
  { icon: 'wrench', label: 'MCP 白名单工具', desc: 'AI 只做被允许的事' },
  { icon: 'zap', label: '流式输出', desc: '回复首字即达' },
  { icon: 'trend', label: '掌握度模型', desc: '练习变成数据' },
];
---

<section class="trust" aria-label="核心技术">
  <div class="container">
    <div class="trust__row">
      {items.map((it, i) => (
        <a href="/tech/" class="trust__item" style={`--reveal-delay:${i * 0.07}s`}>
          <Icon name={it.icon} size={24} class="trust__icon" />
          <span class="trust__text">
            <span class="trust__label">{it.label}</span>
            <span class="trust__desc">{it.desc}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .trust { padding-block: 1.15rem; margin-top: 2.2rem; }
  .trust__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.1rem 1rem;
    text-align: center;
    color: inherit;
    border-left: 1px solid var(--divider);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .trust__item:first-child { border-left: 0; }
  .trust__item:hover { background: rgba(157, 107, 255, 0.06); }
  .trust__icon { color: var(--icon-color); flex-shrink: 0; }
  .trust__text { display: grid; gap: 0.12rem; justify-items: center; }
  .trust__label { font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--text-primary); }
  .trust__desc { font-size: var(--fs-xs); color: var(--text-muted); }
  .trust__item:hover .trust__label { color: var(--brand-400); }

  @media (max-width: 900px) {
    .trust__row { grid-template-columns: 1fr 1fr; }
    .trust__item:nth-child(3) { border-left: 0; }
    .trust__item:nth-child(n + 3) { border-top: 1px solid var(--divider); }
  }
  @media (max-width: 480px) {
    .trust__row { grid-template-columns: 1fr; }
    .trust__item { border-left: 0; }
    .trust__item + .trust__item { border-top: 1px solid var(--divider); }
  }
</style>
