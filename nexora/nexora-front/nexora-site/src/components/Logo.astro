---
/**
 * 品牌标识：现用产品 Logo（public/favicon.svg，过渡方案）+ 渐变字标。
 * Logo 重构时：替换 public/favicon.svg 并调整此组件即可，全站自动跟随。
 */
interface Props {
  /** 图标边长（px） */
  size?: number;
  /** 是否显示 Nexora 渐变字标（导航处默认关闭，页脚开启） */
  withWordmark?: boolean;
}
const { size = 28, withWordmark = false } = Astro.props;
---

<span class="logo">
  <img src="/favicon.svg" alt="" width={size} height={size} class="logo__mark" aria-hidden="true" />
  {withWordmark && <span class="logo__word">Nexora</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo__mark {
    filter: drop-shadow(0 0 14px rgba(134, 59, 255, 0.5));
  }
  .logo__word {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
