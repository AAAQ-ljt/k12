<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nexora</groupId>
        <artifactId>nexora</artifactId>
        <version>1.0.0</version>
    </parent>

    <groupId>com.nexora</groupId>
    <artifactId>nexora-mcp</artifactId>
    <version>1.0.0</version>

    <dependencies>
        <dependency>
            <groupId>com.nexora</groupId>
            <artifactId>nexora-common</artifactId>
            <version>1.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-actuator</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 公共组件引用 VectorStore API，MCP 尚不装配向量存储 Bean，仅需该依赖保证类可加载 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>
        <!-- 公共组件 AiUsageAdvisor 实现 Spring AI 的 CallAdvisor / StreamAdvisor，
             而 MCP 组件扫描 com.nexora 时会去解析它实现的接口。
             MCP 自身不装配对话模型（advisor 只挂在 admin / web 的 ChatClient 上），
             这里显式声明纯粹是为了保证组件扫描阶段这些接口类可加载——
             不能依赖从 nexora-common 传递：IDEA 解析出的模块 classpath 曾漏掉该 jar，
             启动直接抛 FileNotFoundException: .../advisor/api/CallAdvisor.class -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!-- MCP Server（响应式） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webflux</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.nexora.NexoraMcpServerApplication</mainClass>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
