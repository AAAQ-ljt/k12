	<!--实体映射-->
	<resultMap id="base_result_map" type="com.nexora.entity.po.CourseStudyLog">
		<!--主键-->
		<id column="id" property="id"  />
		<!--学生-->
		<result column="user_id" property="userId"  />
		<!--课程-->
		<result column="course_id" property="courseId"  />
		<!--课时-->
		<result column="lesson_id" property="lessonId"  />
		<!--学习日期【冗余：连续打卡/时长统计按天聚合】-->
		<result column="study_date" property="studyDate"  />
		<!--本次时长（秒）-->
		<result column="duration" property="duration"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 c.id,c.user_id,c.course_id,c.lesson_id,c.study_date,
		 c.duration,c.create_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.id != null">
				 and  c.id = #{query.id}
			</if>
			<if test="query.userId != null">
				 and  c.user_id = #{query.userId}
			</if>
			<if test="query.courseId != null and query.courseId!=''">
				 and  c.course_id = #{query.courseId}
			</if>
			<if test="query.lessonId != null and query.lessonId!=''">
				 and  c.lesson_id = #{query.lessonId}
			</if>
			<if test="query.studyDate != null and query.studyDate!=''">
				 <![CDATA[ and  c.study_date=str_to_date(#{query.studyDate}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.duration != null">
				 and  c.duration = #{query.duration}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  c.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.courseIdFuzzy!= null  and query.courseIdFuzzy!=''">
				 and  c.course_id like concat('%', #{query.courseIdFuzzy}, '%')
			</if>
			<if test="query.lessonIdFuzzy!= null  and query.lessonIdFuzzy!=''">
				 and  c.lesson_id like concat('%', #{query.lessonIdFuzzy}, '%')
			</if>
			<if test="query.studyDateStart!= null and query.studyDateStart!=''">
				 <![CDATA[ and  c.study_date>=str_to_date(#{query.studyDateStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.studyDateEnd!= null and query.studyDateEnd!=''">
				 <![CDATA[ and  c.study_date< date_sub(str_to_date(#{query.studyDateEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  c.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  c.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM course_study_log c <include refid="query_condition" />
		 <if test="query.orderBy!=null">
