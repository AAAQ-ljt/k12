	<!--实体映射-->
	<resultMap id="base_result_map" type="com.nexora.entity.po.QuestionInfo">
		<!--题目ID-->
		<result column="question_id" property="questionId"  />
		<!--知识点【冗余：出题/练习主筛选键】-->
		<result column="knowledge_point_id" property="knowledgePointId"  />
		<!--学段【冗余：按学段抽题免join】-->
		<result column="stage" property="stage"  />
		<!--年级【按年级抽题免join】-->
		<result column="grade" property="grade"  />
		<!--难度：1-3-->
		<result column="difficulty" property="difficulty"  />
		<!--题型：0单选 1多选 2判断 3填空-->
		<result column="question_type" property="questionType"  />
		<!--题干-->
		<result column="title" property="title"  />
		<!--题目配图，关联resource_info.resource_id，多个逗号分隔，可空-->
		<result column="question_image" property="questionImage"  />
		<!--判断/填空答案；选择题答案在选项表-->
		<result column="answer" property="answer"  />
		<!--解析-->
		<result column="analysis" property="analysis"  />
		<!--来源：0管理员录入 1AI生成-->
		<result column="source" property="source"  />
		<!--审核：0待审核 1已上架 2已驳回-->
		<result column="audit_status" property="auditStatus"  />
		<!--默认分值-->
		<result column="score" property="score"  />
		<!--状态：0停用 1启用-->
		<result column="status" property="status"  />
		<!--录入人，可空（AI生成为空）-->
		<result column="create_by" property="createBy"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 q.question_id,q.knowledge_point_id,q.stage,q.grade,q.difficulty,q.question_type,
		 q.title,q.question_image,q.answer,q.analysis,q.source,
		 q.audit_status,q.score,q.status,q.create_by,q.create_time,
