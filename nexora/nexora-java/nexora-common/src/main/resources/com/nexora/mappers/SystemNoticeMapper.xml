			</if>
			<if test="bean.content != null">
				 content = #{bean.content},
			</if>
			<if test="bean.status != null">
				 status = #{bean.status},
			</if>
			<if test="bean.publishTime != null">
				 publish_time = #{bean.publishTime},
			</if>
			<if test="bean.createTime != null">
				 create_time = #{bean.createTime},
			</if>
			<if test="bean.updateTime != null">
				 update_time = #{bean.updateTime},
			</if>
 		 </set>
 		 where notice_id=#{noticeId}
	</update>

	<!-- 根据NoticeId删除-->
	<delete id="deleteByNoticeId">
		delete from system_notice where notice_id=#{noticeId}
	</delete>

	<!-- 根据PrimaryKey获取对象-->
	<select id="selectByNoticeId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from system_notice s where notice_id=#{noticeId}
	</select>

</mapper>