			</if>
		 </trim>
	</insert>

	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.nexora.entity.po.SystemNotice" useGeneratedKeys="true" keyProperty="noticeId">
		 INSERT INTO system_notice(
			 title,
			 content,
			 status,
			 publish_time,
			 create_time,
			 update_time
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.title},
				 #{item.content},
				 #{item.status},
				 #{item.publishTime},
				 #{item.createTime},
				 #{item.updateTime}
			 )
		 </foreach>
	</insert>

	<!-- 批量新增修改 （批量插入）-->
	<insert id="insertOrUpdateBatch" parameterType="com.nexora.entity.po.SystemNotice">
		 INSERT INTO system_notice(
			 title,
			 content,
			 status,
			 publish_time,
