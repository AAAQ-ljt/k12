		 a.template_id,a.template_name,a.template_type,a.stage,a.description,
		 a.template_content,a.preview_url,a.status,a.create_by,a.create_time,
		 a.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.templateId != null">
				 and  a.template_id = #{query.templateId}
			</if>
			<if test="query.templateName != null and query.templateName!=''">
				 and  a.template_name = #{query.templateName}
			</if>
			<if test="query.templateType != null and query.templateType!=''">
				 and  a.template_type = #{query.templateType}
			</if>
			<if test="query.stage != null and query.stage!=''">
				 and  a.stage = #{query.stage}
			</if>
			<if test="query.description != null and query.description!=''">
				 and  a.description = #{query.description}
			</if>
			<if test="query.templateContent != null and query.templateContent!=''">
				 and  a.template_content = #{query.templateContent}
			</if>
			<if test="query.previewUrl != null and query.previewUrl!=''">
				 and  a.preview_url = #{query.previewUrl}
			</if>
			<if test="query.status != null">
				 and  a.status = #{query.status}
			</if>
			<if test="query.createBy != null">
				 and  a.create_by = #{query.createBy}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  a.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  a.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.templateNameFuzzy!= null  and query.templateNameFuzzy!=''">
				 and  a.template_name like concat('%', #{query.templateNameFuzzy}, '%')
			</if>
			<if test="query.templateTypeFuzzy!= null  and query.templateTypeFuzzy!=''">
				 and  a.template_type like concat('%', #{query.templateTypeFuzzy}, '%')
			</if>
			<if test="query.stageFuzzy!= null  and query.stageFuzzy!=''">
				 and  a.stage like concat('%', #{query.stageFuzzy}, '%')
			</if>
			<if test="query.descriptionFuzzy!= null  and query.descriptionFuzzy!=''">
				 and  a.description like concat('%', #{query.descriptionFuzzy}, '%')
			</if>
			<if test="query.templateContentFuzzy!= null  and query.templateContentFuzzy!=''">
				 and  a.template_content like concat('%', #{query.templateContentFuzzy}, '%')
			</if>
			<if test="query.previewUrlFuzzy!= null  and query.previewUrlFuzzy!=''">
				 and  a.preview_url like concat('%', #{query.previewUrlFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  a.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  a.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  a.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  a.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
