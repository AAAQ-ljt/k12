			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.docIdFuzzy!= null  and query.docIdFuzzy!=''">
				 and  k.doc_id like concat('%', #{query.docIdFuzzy}, '%')
			</if>
			<if test="query.docIds != null and query.docIds.size() > 0">
				 and k.doc_id in
				 <foreach collection="query.docIds" item="item" open="(" separator="," close=")">
					 #{item}
				 </foreach>
			</if>
			<if test="query.titleFuzzy!= null  and query.titleFuzzy!=''">
				 and  k.title like concat('%', #{query.titleFuzzy}, '%')
			</if>
			<if test="query.stageFuzzy!= null  and query.stageFuzzy!=''">
				 and  k.stage like concat('%', #{query.stageFuzzy}, '%')
			</if>
			<if test="query.knowledgePointIdFuzzy!= null  and query.knowledgePointIdFuzzy!=''">
				 and  k.knowledge_point_id like concat('%', #{query.knowledgePointIdFuzzy}, '%')
			</if>
			<if test="query.dataTypeFuzzy!= null  and query.dataTypeFuzzy!=''">
				 and  k.data_type like concat('%', #{query.dataTypeFuzzy}, '%')
			</if>
			<if test="query.contentFuzzy!= null  and query.contentFuzzy!=''">
