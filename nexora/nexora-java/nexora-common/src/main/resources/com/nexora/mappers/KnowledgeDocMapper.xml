		 k.vector_status,k.vector_error,k.chunk_count,k.status,k.create_by,
		 k.create_time,k.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.docId != null and query.docId!=''">
				 and  k.doc_id = #{query.docId}
			</if>
			<if test="query.title != null and query.title!=''">
