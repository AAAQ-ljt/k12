				 and  k.owner_id is null
			</if>
			<if test="query.ownerIdNull != null and !query.ownerIdNull">
				 and  k.owner_id is not null
			</if>
			<if test="query.difficulty != null">
				 and  k.difficulty = #{query.difficulty}
