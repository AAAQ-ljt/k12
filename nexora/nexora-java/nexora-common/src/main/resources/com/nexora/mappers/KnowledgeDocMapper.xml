	<!--实体映射-->
	<resultMap id="base_result_map" type="com.nexora.entity.po.KnowledgeDoc">
		<!--文档ID-->
		<result column="doc_id" property="docId"  />
		<!--标题-->
		<result column="title" property="title"  />
		<!--学段【冗余：与ES metadata双写一致】-->
		<result column="stage" property="stage"  />
		<!--知识点【冗余：检索过滤/管理筛选免join】-->
		<result column="knowledge_point_id" property="knowledgePointId"  />
		<!--归属用户ID；NULL=官方知识库，非空=学生个人知识库-->
		<result column="owner_id" property="ownerId"  />
		<!--难度：1-3-->
		<result column="difficulty" property="difficulty"  />
		<!--数据类型，默认KNOWLEDGE-->
		<result column="data_type" property="dataType"  />
		<!--正文（Markdown）-->
		<result column="content" property="content"  />
		<!--来源：0手动维护 1资料解析-->
		<result column="source_type" property="sourceType"  />
		<!--来源资源ID（解析入库时回填），可空-->
		<result column="source_resource_id" property="sourceResourceId"  />
		<!--资料链接（超链接文档），可空-->
		<result column="source_url" property="sourceUrl"  />
		<!--向量状态：0待处理 1处理中 2已完成 3失败 4过期-->
		<result column="vector_status" property="vectorStatus"  />
		<!--向量化失败时的错误原因，可空-->
		<result column="vector_error" property="vectorError"  />
		<!--入库分块数-->
		<result column="chunk_count" property="chunkCount"  />
		<!--状态：0下架 1上架-->
		<result column="status" property="status"  />
		<!--维护人-->
		<result column="create_by" property="createBy"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
