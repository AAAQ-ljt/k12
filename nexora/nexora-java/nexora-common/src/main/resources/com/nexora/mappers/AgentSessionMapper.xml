	<!--实体映射-->
	<resultMap id="base_result_map" type="com.nexora.entity.po.AgentSession">
		<!--会话ID-->
		<result column="session_id" property="sessionId"  />
		<!--学生-->
		<result column="user_id" property="userId"  />
		<!--会话标题（首条消息摘要）-->
		<result column="title" property="title"  />
		<!--学段【冗余快照：会话创建时学段】-->
		<result column="stage" property="stage"  />
		<!--当前学习知识点，可空-->
		<result column="knowledge_point_id" property="knowledgePointId"  />
		<!--场景：0自由对话 1课程引导 2路径引导-->
		<result column="scene" property="scene"  />
		<!--消息数【冗余：会话列表展示】-->
		<result column="message_count" property="messageCount"  />
		<!--最后消息时间【冗余：列表排序免max聚合】-->
		<result column="last_message_time" property="lastMessageTime"  />
		<!--状态：0正常 1归档-->
		<result column="status" property="status"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 a.session_id,a.user_id,a.title,a.stage,a.knowledge_point_id,
		 a.scene,a.message_count,a.last_message_time,a.status,a.create_time,
		 a.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.sessionId != null and query.sessionId!=''">
				 and  a.session_id = #{query.sessionId}
			</if>
			<if test="query.userId != null">
				 and  a.user_id = #{query.userId}
			</if>
			<if test="query.title != null and query.title!=''">
				 and  a.title = #{query.title}
			</if>
			<if test="query.stage != null and query.stage!=''">
				 and  a.stage = #{query.stage}
			</if>
			<if test="query.knowledgePointId != null and query.knowledgePointId!=''">
				 and  a.knowledge_point_id = #{query.knowledgePointId}
			</if>
			<if test="query.scene != null">
				 and  a.scene = #{query.scene}
			</if>
			<if test="query.messageCount != null">
				 and  a.message_count = #{query.messageCount}
			</if>
			<if test="query.lastMessageTime != null and query.lastMessageTime!=''">
				 <![CDATA[ and  a.last_message_time=str_to_date(#{query.lastMessageTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.status != null">
				 and  a.status = #{query.status}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  a.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  a.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.sessionIdFuzzy!= null  and query.sessionIdFuzzy!=''">
				 and  a.session_id like concat('%', #{query.sessionIdFuzzy}, '%')
			</if>
			<if test="query.titleFuzzy!= null  and query.titleFuzzy!=''">
				 and  a.title like concat('%', #{query.titleFuzzy}, '%')
			</if>
			<if test="query.stageFuzzy!= null  and query.stageFuzzy!=''">
				 and  a.stage like concat('%', #{query.stageFuzzy}, '%')
			</if>
			<if test="query.knowledgePointIdFuzzy!= null  and query.knowledgePointIdFuzzy!=''">
				 and  a.knowledge_point_id like concat('%', #{query.knowledgePointIdFuzzy}, '%')
			</if>
			<if test="query.lastMessageTimeStart!= null and query.lastMessageTimeStart!=''">
				 <![CDATA[ and  a.last_message_time>=str_to_date(#{query.lastMessageTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.lastMessageTimeEnd!= null and query.lastMessageTimeEnd!=''">
				 <![CDATA[ and  a.last_message_time< date_sub(str_to_date(#{query.lastMessageTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  a.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  a.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  a.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  a.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
