		<!--产物类型，可空：ANIMATION/PICTURE_BOOK/QUIZ/RESOURCE_LIST/CODE-->
		<result column="biz_type" property="bizType"  />
		<!--产物结构化JSON（卡片数据）-->
		<result column="biz_data" property="bizData"  />
		<!--关联生成记录，可空-->
		<result column="generation_id" property="generationId"  />
		<!--状态：0处理中 1完成 2取消 3错误-->
		<result column="status" property="status"  />
		<!--错误信息，可空-->
		<result column="error_info" property="errorInfo"  />
		<!--输入token用量，默认0-->
		<result column="prompt_tokens" property="promptTokens"  />
