	<!--实体映射-->
	<resultMap id="base_result_map" type="com.nexora.entity.po.PracticeRecord">
		<!--记录ID-->
		<id column="record_id" property="recordId"  />
		<!--学生-->
		<result column="user_id" property="userId"  />
		<!--知识点【冗余快照：提交时从题目复制】-->
		<result column="knowledge_point_id" property="knowledgePointId"  />
		<!--学段【冗余快照：按学段分析免join】-->
		<result column="stage" property="stage"  />
		<!--题目ID-->
		<result column="question_id" property="questionId"  />
		<!--题型【冗余快照】-->
		<result column="question_type" property="questionType"  />
		<!--学生作答-->
		<result column="user_answer" property="userAnswer"  />
		<!--0错 1对-->
		<result column="is_correct" property="isCorrect"  />
		<!--得分-->
		<result column="score" property="score"  />
		<!--用时（秒）-->
		<result column="duration" property="duration"  />
		<!--来源：0对话练习 1路径快测 2遗忘复习-->
		<result column="source" property="source"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 p.record_id,p.user_id,p.knowledge_point_id,p.stage,p.question_id,
		 p.question_type,p.user_answer,p.is_correct,p.score,p.duration,
		 p.source,p.create_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.recordId != null">
				 and  p.record_id = #{query.recordId}
			</if>
			<if test="query.userId != null">
				 and  p.user_id = #{query.userId}
			</if>
			<if test="query.knowledgePointId != null and query.knowledgePointId!=''">
				 and  p.knowledge_point_id = #{query.knowledgePointId}
			</if>
			<if test="query.stage != null and query.stage!=''">
				 and  p.stage = #{query.stage}
			</if>
			<if test="query.questionId != null and query.questionId!=''">
				 and  p.question_id = #{query.questionId}
			</if>
			<if test="query.questionType != null">
				 and  p.question_type = #{query.questionType}
			</if>
			<if test="query.userAnswer != null and query.userAnswer!=''">
				 and  p.user_answer = #{query.userAnswer}
			</if>
			<if test="query.isCorrect != null">
				 and  p.is_correct = #{query.isCorrect}
			</if>
			<if test="query.score != null">
				 and  p.score = #{query.score}
			</if>
			<if test="query.duration != null">
				 and  p.duration = #{query.duration}
			</if>
			<if test="query.source != null">
				 and  p.source = #{query.source}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  p.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.knowledgePointIdFuzzy!= null  and query.knowledgePointIdFuzzy!=''">
				 and  p.knowledge_point_id like concat('%', #{query.knowledgePointIdFuzzy}, '%')
			</if>
			<if test="query.stageFuzzy!= null  and query.stageFuzzy!=''">
				 and  p.stage like concat('%', #{query.stageFuzzy}, '%')
			</if>
			<if test="query.questionIdFuzzy!= null  and query.questionIdFuzzy!=''">
				 and  p.question_id like concat('%', #{query.questionIdFuzzy}, '%')
			</if>
			<if test="query.userAnswerFuzzy!= null  and query.userAnswerFuzzy!=''">
				 and  p.user_answer like concat('%', #{query.userAnswerFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  p.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  p.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM practice_record p <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
