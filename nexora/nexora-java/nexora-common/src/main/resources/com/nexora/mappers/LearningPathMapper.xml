			</if>
			<if test="query.source != null">
				 and  l.source = #{query.source}
			</if>
			<if test="query.status != null">
				 and  l.status = #{query.status}
			</if>
			<if test="query.totalItems != null">
				 and  l.total_items = #{query.totalItems}
			</if>
			<if test="query.finishedItems != null">
