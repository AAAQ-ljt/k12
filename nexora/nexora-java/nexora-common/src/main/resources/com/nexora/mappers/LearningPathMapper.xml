		 l.path_id,l.user_id,l.title,l.stage,l.source,
		 l.status,l.total_items,l.finished_items,l.progress,l.current_item_id,
		 l.create_time,l.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.pathId != null and query.pathId!=''">
				 and  l.path_id = #{query.pathId}
			</if>
			<if test="query.userId != null">
				 and  l.user_id = #{query.userId}
			</if>
