		 k.description,k.cover,k.lesson_id,k.sort,k.status,
		 k.create_time,k.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.knowledgePointId != null and query.knowledgePointId!=''">
				 and  k.knowledge_point_id = #{query.knowledgePointId}
			</if>
			<if test="query.name != null and query.name!=''">
