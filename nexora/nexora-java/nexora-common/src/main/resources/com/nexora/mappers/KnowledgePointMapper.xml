			</if>
			<if test="query.stage != null and query.stage!=''">
				 and  k.stage = #{query.stage}
			</if>
			<if test="query.subject != null and query.subject!=''">
				 and  k.subject = #{query.subject}
			</if>
			<if test="query.difficulty != null">
				 and  k.difficulty = #{query.difficulty}
			</if>
			<if test="query.description != null and query.description!=''">
				 and  k.description = #{query.description}
			</if>
			<if test="query.cover != null and query.cover!=''">
				 and  k.cover = #{query.cover}
			</if>
			<if test="query.lessonId != null and query.lessonId!=''">
				 and  k.lesson_id = #{query.lessonId}
			</if>
			<if test="query.sort != null">
				 and  k.sort = #{query.sort}
			</if>
			<if test="query.status != null">
				 and  k.status = #{query.status}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  k.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  k.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.knowledgePointIdFuzzy!= null  and query.knowledgePointIdFuzzy!=''">
				 and  k.knowledge_point_id like concat('%', #{query.knowledgePointIdFuzzy}, '%')
			</if>
			<if test="query.nameFuzzy!= null  and query.nameFuzzy!=''">
				 and  k.name like concat('%', #{query.nameFuzzy}, '%')
			</if>
			<if test="query.stageFuzzy!= null  and query.stageFuzzy!=''">
				 and  k.stage like concat('%', #{query.stageFuzzy}, '%')
			</if>
			<if test="query.subjectFuzzy!= null  and query.subjectFuzzy!=''">
				 and  k.subject like concat('%', #{query.subjectFuzzy}, '%')
			</if>
			<if test="query.descriptionFuzzy!= null  and query.descriptionFuzzy!=''">
				 and  k.description like concat('%', #{query.descriptionFuzzy}, '%')
			</if>
			<if test="query.coverFuzzy!= null  and query.coverFuzzy!=''">
				 and  k.cover like concat('%', #{query.coverFuzzy}, '%')
			</if>
			<if test="query.lessonIdFuzzy!= null  and query.lessonIdFuzzy!=''">
				 and  k.lesson_id like concat('%', #{query.lessonIdFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  k.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  k.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  k.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  k.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
