	<!--实体映射-->
	<resultMap id="base_result_map" type="com.nexora.entity.po.PromptTemplate">
		<!--主键-->
		<id column="id" property="id"  />
		<!--学段；ALL表示通用模板-->
		<result column="stage" property="stage"  />
		<!--场景/意图：EXPLAIN/QUIZ/PICTURE_BOOK/DRAW/ANIMATION/CODING/PLAN/PROGRESS/CHAT等-->
		<result column="scene" property="scene"  />
		<!--模板名-->
		<result column="template_name" property="templateName"  />
		<!--提示词内容（必须含"知识库无相关内容时如实说明，不要编造"类约束）-->
		<result column="content" property="content"  />
		<!--状态：0停用 1启用-->
		<result column="status" property="status"  />
		<!--备注-->
		<result column="remark" property="remark"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 p.id,p.stage,p.scene,p.template_name,p.content,
		 p.status,p.remark,p.create_time,p.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.id != null">
				 and  p.id = #{query.id}
			</if>
			<if test="query.stage != null and query.stage!=''">
				 and  p.stage = #{query.stage}
			</if>
			<if test="query.scene != null and query.scene!=''">
				 and  p.scene = #{query.scene}
			</if>
			<if test="query.templateName != null and query.templateName!=''">
				 and  p.template_name = #{query.templateName}
			</if>
			<if test="query.content != null and query.content!=''">
				 and  p.content = #{query.content}
			</if>
			<if test="query.status != null">
				 and  p.status = #{query.status}
			</if>
			<if test="query.remark != null and query.remark!=''">
				 and  p.remark = #{query.remark}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  p.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  p.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.stageFuzzy!= null  and query.stageFuzzy!=''">
				 and  p.stage like concat('%', #{query.stageFuzzy}, '%')
			</if>
			<if test="query.sceneFuzzy!= null  and query.sceneFuzzy!=''">
				 and  p.scene like concat('%', #{query.sceneFuzzy}, '%')
			</if>
			<if test="query.templateNameFuzzy!= null  and query.templateNameFuzzy!=''">
				 and  p.template_name like concat('%', #{query.templateNameFuzzy}, '%')
			</if>
			<if test="query.contentFuzzy!= null  and query.contentFuzzy!=''">
				 and  p.content like concat('%', #{query.contentFuzzy}, '%')
			</if>
			<if test="query.remarkFuzzy!= null  and query.remarkFuzzy!=''">
				 and  p.remark like concat('%', #{query.remarkFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  p.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  p.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  p.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  p.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM prompt_template p <include refid="query_condition" />
		 <if test="query.orderBy!=null">
