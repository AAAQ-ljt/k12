<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexora.mappers.ResourceInfoMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.nexora.entity.po.ResourceInfo">
		<!--资源ID-->
		<result column="resource_id" property="resourceId"  />
		<!--资源名-->
		<result column="resource_name" property="resourceName"  />
		<!--类型：VIDEO/DOCUMENT/PPT/WORD/IMAGE/PICTURE_BOOK-->
		<result column="resource_type" property="resourceType"  />
		<!--资源标签，多个逗号分隔-->
		<result column="tags" property="tags"  />
		<!--资源简介-->
		<result column="description" property="description"  />
		<!--文件地址-->
		<result column="file_path" property="filePath"  />
		<!--文件大小（字节）-->
		<result column="file_size" property="fileSize"  />
		<!--封面-->
		<result column="cover" property="cover"  />
		<!--音视频时长（秒）-->
		<result column="duration" property="duration"  />
		<!--HLS转码产物地址-->
		<result column="hls_path" property="hlsPath"  />
		<!--归属用户ID；NULL=管理端公共资源-->
		<result column="owner_id" property="ownerId"  />
		<!--产物扩展信息（动画步骤/绘本分页/播放配置等）-->
		<result column="ext_json" property="extJson"  />
		<!--归属学段，可空-->
		<result column="stage" property="stage"  />
		<!--关联知识点【冗余：recommendResource工具按知识点直查】-->
		<result column="knowledge_point_id" property="knowledgePointId"  />
		<!--所属资源目录ID-->
		<result column="directory_id" property="directoryId"  />
		<!--来源：0后台上传 1AI生成-->
		<result column="source" property="source"  />
		<!--状态：0处理中 1可用 2失败-->
		<result column="status" property="status"  />
		<!--上传人-->
		<result column="create_by" property="createBy"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 r.resource_id,r.resource_name,r.resource_type,r.tags,r.description,
		 r.file_path,r.file_size,r.cover,r.duration,r.hls_path,
		 r.owner_id,r.ext_json,r.stage,r.knowledge_point_id,r.directory_id,r.source,r.status,r.create_by,
		 r.create_time,r.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.resourceId != null and query.resourceId!=''">
				 and  r.resource_id = #{query.resourceId}
			</if>
			<if test="query.resourceName != null and query.resourceName!=''">
				 and  r.resource_name = #{query.resourceName}
			</if>
			<if test="query.resourceType != null and query.resourceType!=''">
				 and  r.resource_type = #{query.resourceType}
			</if>
			<if test="query.tags != null and query.tags!=''">
				 and  r.tags = #{query.tags}
			</if>
			<if test="query.description != null and query.description!=''">
				 and  r.description = #{query.description}
			</if>
			<if test="query.filePath != null and query.filePath!=''">
				 and  r.file_path = #{query.filePath}
			</if>
			<if test="query.fileSize != null">
				 and  r.file_size = #{query.fileSize}
			</if>
			<if test="query.cover != null and query.cover!=''">
				 and  r.cover = #{query.cover}
			</if>
			<if test="query.duration != null">
				 and  r.duration = #{query.duration}
			</if>
			<if test="query.hlsPath != null and query.hlsPath!=''">
				 and  r.hls_path = #{query.hlsPath}
			</if>
			<if test="query.ownerId != null and query.ownerId!=''">
				 and  r.owner_id = #{query.ownerId}
			</if>
			<if test="query.ownerIdNull != null and query.ownerIdNull">
				 and  r.owner_id is null
			</if>
			<if test="query.stage != null and query.stage!=''">
				 and  r.stage = #{query.stage}
			</if>
			<if test="query.knowledgePointId != null and query.knowledgePointId!=''">
				 and  r.knowledge_point_id = #{query.knowledgePointId}
			</if>
			<if test="query.directoryId != null and query.directoryId!=''">
				 and  r.directory_id = #{query.directoryId}
			</if>
			<if test="query.source != null">
				 and  r.source = #{query.source}
			</if>
			<if test="query.status != null">
				 and  r.status = #{query.status}
			</if>
			<if test="query.createBy != null">
				 and  r.create_by = #{query.createBy}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  r.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  r.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.resourceIdFuzzy!= null  and query.resourceIdFuzzy!=''">
				 and  r.resource_id like concat('%', #{query.resourceIdFuzzy}, '%')
			</if>
			<if test="query.resourceIds != null and query.resourceIds.size() > 0">
				 and r.resource_id in
				 <foreach collection="query.resourceIds" item="item" open="(" separator="," close=")">
					 #{item}
				 </foreach>
			</if>
			<if test="query.resourceNameFuzzy!= null  and query.resourceNameFuzzy!=''">
				 and  r.resource_name like concat('%', #{query.resourceNameFuzzy}, '%')
			</if>
			<if test="query.resourceTypeFuzzy!= null  and query.resourceTypeFuzzy!=''">
				 and  r.resource_type like concat('%', #{query.resourceTypeFuzzy}, '%')
			</if>
			<if test="query.tagsFuzzy!= null  and query.tagsFuzzy!=''">
				 and  r.tags like concat('%', #{query.tagsFuzzy}, '%')
			</if>
			<if test="query.descriptionFuzzy!= null  and query.descriptionFuzzy!=''">
				 and  r.description like concat('%', #{query.descriptionFuzzy}, '%')
			</if>
			<if test="query.filePathFuzzy!= null  and query.filePathFuzzy!=''">
				 and  r.file_path like concat('%', #{query.filePathFuzzy}, '%')
			</if>
			<if test="query.coverFuzzy!= null  and query.coverFuzzy!=''">
				 and  r.cover like concat('%', #{query.coverFuzzy}, '%')
			</if>
			<if test="query.hlsPathFuzzy!= null  and query.hlsPathFuzzy!=''">
				 and  r.hls_path like concat('%', #{query.hlsPathFuzzy}, '%')
			</if>
			<if test="query.stageFuzzy!= null  and query.stageFuzzy!=''">
				 and  r.stage like concat('%', #{query.stageFuzzy}, '%')
			</if>
			<if test="query.knowledgePointIdFuzzy!= null  and query.knowledgePointIdFuzzy!=''">
				 and  r.knowledge_point_id like concat('%', #{query.knowledgePointIdFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  r.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  r.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  r.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  r.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM resource_info r <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM resource_info r <include refid="query_condition" />
	</select>

