		 s.description,s.status,s.create_time,s.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.configId != null">
				 and  s.config_id = #{query.configId}
			</if>
			<if test="query.configGroup != null and query.configGroup!=''">
				 and  s.config_group = #{query.configGroup}
			</if>
			<if test="query.configKey != null and query.configKey!=''">
				 and  s.config_key = #{query.configKey}
			</if>
			<if test="query.configValue != null and query.configValue!=''">
