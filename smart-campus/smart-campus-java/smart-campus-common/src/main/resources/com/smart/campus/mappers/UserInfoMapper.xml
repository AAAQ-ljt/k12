    <!--实体映射-->
    <resultMap id="base_result_map" type="com.smart.campus.entity.po.UserInfo">
        <!--主键ID-->
        <id column="user_id" property="userId"/>
        <!--用户编号/学号/工号/管理员账号-->
        <result column="user_no" property="userNo"/>
        <!--登录密码-->
        <result column="password" property="password"/>
        <!--真实姓名-->
        <result column="real_name" property="realName"/>
        <!--性别: 1男 2女 0未知-->
        <result column="gender" property="gender"/>
        <!--手机号-->
        <result column="phone" property="phone"/>
        <!--邮箱-->
        <result column="email" property="email"/>
        <!--头像地址-->
        <result column="avatar" property="avatar"/>
        <!--角色类型: 0:管理员 1:老师  2:学生-->
        <result column="role_type" property="roleType"/>
        <!--班级ID-->
        <result column="class_id" property="classId"/>
        <!--职称(教师用)-->
        <result column="title_name" property="titleName"/>
        <!--状态: 1启用 0停用-->
        <result column="status" property="status"/>
        <!--最后登录时间-->
        <result column="last_login_time" property="lastLoginTime"/>
    </resultMap>


    <!-- 通用查询结果列-->
    <sql id="base_column_list">
        u.user_id,u.user_no,u.password,u.real_name,u.gender,
        u.phone,u.email,u.avatar,u.role_type,u.class_id,
        u.title_name,u.status,u.last_login_time
    </sql>

    <sql id="base_condition_filed">
        <if test="query.userId != null">
            and u.user_id = #{query.userId}
        </if>
        <if test="query.userNo != null and query.userNo!=''">
            and u.user_no = #{query.userNo}
        </if>
        <if test="query.password != null and query.password!=''">
            and u.password = #{query.password}
        </if>
        <if test="query.realName != null and query.realName!=''">
            and u.real_name = #{query.realName}
        </if>
        <if test="query.gender != null">
            and u.gender = #{query.gender}
        </if>
        <if test="query.phone != null and query.phone!=''">
            and u.phone = #{query.phone}
        </if>
        <if test="query.email != null and query.email!=''">
            and u.email = #{query.email}
        </if>
        <if test="query.avatar != null and query.avatar!=''">
            and u.avatar = #{query.avatar}
        </if>
        <if test="query.roleType != null">
            and u.role_type = #{query.roleType}
        </if>
        <if test="query.classId != null and query.classId!=''">
            and u.class_id = #{query.classId}
        </if>
        <if test="query.titleName != null and query.titleName!=''">
            and u.title_name = #{query.titleName}
        </if>
        <if test="query.status != null">
            and u.status = #{query.status}
        </if>
        <if test="query.lastLoginTime != null and query.lastLoginTime!=''">
            <![CDATA[ and  u.last_login_time=str_to_date(#{query.lastLoginTime}, '%Y-%m-%d') ]]>
        </if>
    </sql>

    <!-- 通用查询条件列-->
    <sql id="query_condition">
        <where>
            <include refid="base_condition_filed"/>
            <if test="query.userNoFuzzy!= null  and query.userNoFuzzy!=''">
                and u.user_no like concat('%', #{query.userNoFuzzy}, '%')
            </if>
            <if test="query.passwordFuzzy!= null  and query.passwordFuzzy!=''">
                and u.password like concat('%', #{query.passwordFuzzy}, '%')
            </if>
            <if test="query.realNameFuzzy!= null  and query.realNameFuzzy!=''">
                and u.real_name like concat('%', #{query.realNameFuzzy}, '%')
            </if>
            <if test="query.phoneFuzzy!= null  and query.phoneFuzzy!=''">
                and u.phone like concat('%', #{query.phoneFuzzy}, '%')
            </if>
            <if test="query.emailFuzzy!= null  and query.emailFuzzy!=''">
                and u.email like concat('%', #{query.emailFuzzy}, '%')
            </if>
            <if test="query.avatarFuzzy!= null  and query.avatarFuzzy!=''">
                and u.avatar like concat('%', #{query.avatarFuzzy}, '%')
            </if>
            <if test="query.classIdFuzzy!= null  and query.classIdFuzzy!=''">
                and u.class_id like concat('%', #{query.classIdFuzzy}, '%')
            </if>
            <if test="query.titleNameFuzzy!= null  and query.titleNameFuzzy!=''">
                and u.title_name like concat('%', #{query.titleNameFuzzy}, '%')
            </if>
            <if test="query.lastLoginTimeStart!= null and query.lastLoginTimeStart!=''">
                <![CDATA[ and  u.last_login_time>=str_to_date(#{query.lastLoginTimeStart}, '%Y-%m-%d') ]]>
            </if>
            <if test="query.lastLoginTimeEnd!= null and query.lastLoginTimeEnd!=''">
                <![CDATA[ and  u.last_login_time< date_sub(str_to_date(#{query.lastLoginTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
            </if>
        </where>
    </sql>

    <!-- 查询集合-->
    <select id="selectList" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM user_info u
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">
            order by ${query.orderBy}
        </if>
        <if test="query.simplePage!=null">
            limit #{query.simplePage.start},#{query.simplePage.end}
        </if>
    </select>

    <!-- 查询数量-->
    <select id="selectCount" resultType="java.lang.Integer">
