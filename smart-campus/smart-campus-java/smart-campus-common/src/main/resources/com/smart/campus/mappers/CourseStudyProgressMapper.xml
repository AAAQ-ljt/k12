	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.courseIdFuzzy!= null  and query.courseIdFuzzy!=''">
				 and  c.course_id like concat('%', #{query.courseIdFuzzy}, '%')
			</if>
			<if test="query.currentChapterIdFuzzy!= null  and query.currentChapterIdFuzzy!=''">
				 and  c.current_chapter_id like concat('%', #{query.currentChapterIdFuzzy}, '%')
			</if>
			<if test="query.currentLessonIdFuzzy!= null  and query.currentLessonIdFuzzy!=''">
